rule bd_php_dropper_sglobal_0 {
  meta:
    author = "roscoe skeens (predefine.ai)"
    license = "https://creativecommons.org/licenses/by-nc-sa/4.0"
    description = "dropper sglobal write"

  strings:
    $r1 = /\b(file_put_contents|move_uploaded_file|fwrite|copy)\s{0,4}\([^)]{0,96}\$_(GET|POST|COOKIE|REQUEST|FILES)[^)]{0,96}\)/ nocase

  condition:
    $r1
}

rule bd_php_rce_arrfn_sglobal_0 {
  meta:
    author = "roscoe skeens (predefine.ai)"
    license = "https://creativecommons.org/licenses/by-nc-sa/4.0"
    description = "rce array fn sglobal"

  strings:
    $r1 = /\$_(GET|POST|REQUEST|COOKIE|SESSION|SERVER)\s{0,4}\[[^\]]{1,32}\]\s{0,4}\(/

  condition:
    $r1
}

rule bd_php_rce_eval_sess_0 {
  meta:
    author = "roscoe skeens (predefine.ai)"
    license = "https://creativecommons.org/licenses/by-nc-sa/4.0"
    description = "rce eval sess"

  strings:
    $r1 = /\$_SESSION\s{0,4}\[/
    $r2 = /\b(eval|assert|system|passthru|shell_exec|exec|call_user_func(_array)?|create_function)\s{0,4}\(/ nocase

  condition:
    $r1 and $r2 and ((@r1[1] < @r2[1] and @r2[1] - @r1[1] < 256) or (@r2[1] < @r1[1] and @r1[1] - @r2[1] < 256))
}

rule bd_php_rce_eval_b64_0 {
  meta:
    author = "roscoe skeens (predefine.ai)"
    license = "https://creativecommons.org/licenses/by-nc-sa/4.0"
    description = "rce eval b64 blob"

  strings:
    $r1 = /\b(eval|assert|system|passthru|shell_exec|exec|create_function)\s{0,4}\(/ nocase
    $r2 = /base64_decode\s{0,4}\(\s{0,4}("[A-Za-z0-9+\/]{80,480}={0,2}"|'[A-Za-z0-9+\/]{80,480}={0,2}')/ nocase

  condition:
    all of them
}

rule bd_php_rce_eval_b64_sglobal_0 {
  meta:
    author = "roscoe skeens (predefine.ai)"
    license = "https://creativecommons.org/licenses/by-nc-sa/4.0"
    description = "rce eval b64 sglobal"

  strings:
    $r1 = /\$_(GET|POST|COOKIE|REQUEST)\b/
    $r2 = /\b(base64_decode|gzinflate|gzuncompress|str_rot13|strrev|hex2bin)\s{0,4}\(/ nocase
    $r3 = /\b(eval|assert|create_function|call_user_func(_array)?)\s{0,4}\(/ nocase

  condition:
    $r1 and $r2 and $r3 and ((@r1[1] < @r3[1] and @r3[1] - @r1[1] < 256 and ((@r2[1] < @r3[1] and @r3[1] - @r2[1] < 256) or (@r3[1] < @r2[1] and @r2[1] - @r3[1] < 256))) or (@r3[1] < @r1[1] and @r1[1] - @r3[1] < 256 and ((@r2[1] < @r3[1] and @r3[1] - @r2[1] < 256) or (@r3[1] < @r2[1] and @r2[1] - @r3[1] < 256))))
}

rule bd_php_rce_eval_pack_hex_0 {
  meta:
    author = "roscoe skeens (predefine.ai)"
    license = "https://creativecommons.org/licenses/by-nc-sa/4.0"
    description = "rce eval pack hex"

  strings:
    $r1 = /\beval\s{0,4}\(/ nocase
    $r2 = /\bpack\s{0,4}\(\s{0,4}["']H\*["']/ nocase

  condition:
    $r1 and $r2 and ((@r1[1] < @r2[1] and @r2[1] - @r1[1] < 128) or (@r2[1] < @r1[1] and @r1[1] - @r2[1] < 128))
}
